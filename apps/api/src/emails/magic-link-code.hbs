<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your EAP sign-in code</title>
  </head>
  <body
    style="margin:0;padding:0;background:#12130f;font-family:'Inter','Segoe UI',Arial,sans-serif;"
  >

    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="background:#12130f;padding:40px 16px;"
    >
      <tr>
        <td align="center">

          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="max-width:560px;background:#1a1c17;border-radius:22px 22px 22px 8px;
                      border:1px solid #2c2f27;overflow:hidden;"
          >

            <!-- Body -->
            <tr>
              <td style="padding:40px 36px 32px;">

                <!-- Brand -->
                <p style="margin:0 0 28px;font-size:13px;font-weight:700;
                           color:#f2efe6;letter-spacing:0.05em;">
                  EAP <span style="color:#7ec9a3;letter-spacing:0.15em;">ECOSYSTEM</span>
                </p>

                <h1 style="margin:0 0 10px;font-size:22px;font-weight:700;color:#f2efe6;
                            line-height:1.3;">
                  Your sign-in code
                </h1>
                <p style="margin:0 0 28px;font-size:14px;color:#8e8a7b;line-height:1.6;">
                  Use the code below to sign in to EAP. It expires in
                  <span style="color:#f2efe6;font-weight:600;">10 minutes</span>.
                </p>

                <!-- Code box (tap to select, then copy — email clients run no JS) -->
                <table cellpadding="0" cellspacing="0" style="margin:0 auto 12px;">
                  <tr>
                    <td
                      style="background:#1c3227;border:2px dashed #7ec9a3;
                              border-radius:12px;padding:20px 40px;text-align:center;"
                    >
                      <span
                        style="font-family:'Courier New',Courier,monospace;
                               font-size:34px;font-weight:700;color:#f2efe6;
                               letter-spacing:10px;user-select:all;-webkit-user-select:all;"
                      >
                        {{code}}
                      </span>
                    </td>
                  </tr>
                </table>

                <p style="margin:0 0 28px;font-size:12px;color:#8e8a7b;text-align:center;">
                  Tap the code to select it, then copy.
                </p>

                <p style="margin:0;font-size:12px;color:#6f6a5e;line-height:1.6;">
                  If you didn't request this code, you can safely ignore this
                  email. Someone may have entered your address by mistake.
                </p>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="background:#0b0c09;padding:16px 36px;border-top:1px solid #2c2f27;"
              >
                <p style="margin:0;font-size:11px;color:#6f6a5e;text-align:center;">
                  © {{year}} EAP Ecosystem · Personal learning, your way
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>
