/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "baseUrl": ".",
    "paths": {
      "@core/*": [
        "src/app/core/*"
      ],
      "@shared/*": [
        "src/app/shared/*"
      ],
      "@features/*": [
        "src/app/features/*"
      ],
      "domain-lib": [
        "../../shared/domain-lib/src/index.ts"
      ],
      "@learning-resource/domain": [
        "../../learning-resource/domain/src/index.ts"
      ],
      "@learning-resource/application": [
        "../../learning-resource/application/src/index.ts"
      ],
      "@pomodoro/domain": [
        "../../pomodoro/domain/src/index.ts"
      ],
      "@pomodoro/application": [
        "../../pomodoro/application/src/index.ts"
      ],
      "@user/domain": [
        "../../user/domain/src/index.ts"
      ],
      "@user/application": [
        "../../user/application/src/index.ts"
      ],
      "@recommendation/domain": [
        "../../recommendation/domain/src/index.ts"
      ],
      "@recommendation/application": [
        "../../recommendation/application/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}