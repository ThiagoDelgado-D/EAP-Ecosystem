{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cauce",
  "mainBinaryName": "Cauce",
  "version": "0.0.0",
  "identifier": "study.cauce.desktop",
  "build": {
    "frontendDist": "../shell-page"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "category": "Education",
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "../../build/api/": "api/",
      "../../build/web/": "web/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
