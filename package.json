{
  "name": "EAP-Ecosystem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "apps/api",
    "apps/web",
    "shared/domain-lib",
    "shared/infrastructure-lib",
    "learning-resource/domain",
    "learning-resource/application",
    "learning-resource/infrastructure",
    "user/domain",
    "user/application",
    "user/infrastructure"
  ],
  "resolutions": {
    "multer": "^2.2.0",
    "ip-address": "^10.3.1",
    "undici": "^7.29.0",
    "dompurify": "^3.4.13",
    "@babel/core": "^7.29.6",
    "ws": "^8.21.0",
    "piscina": "^5.2.0",
    "postcss": "^8.5.23",
    "esbuild": "^0.28.1",
    "vite@npm:7.3.2": "7.3.5",
    "vite@npm:^6.0.0 || ^7.0.0 || ^8.0.0": "8.0.16",
    "brace-expansion@npm:^2.0.2": "2.1.4",
    "brace-expansion@npm:^5.0.5": "5.0.9",
    "js-yaml@npm:^3.13.1": "4.3.1",
    "js-yaml@npm:^4.1.0": "4.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "@vitest/coverage-v8": "^4.0.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "scripts": {
    "build": "yarn workspaces foreach -A -tv run build",
    "test:ci": "yarn workspaces foreach -A -tv run test",
    "test:all": "yarn test && yarn test:templates",
    "test": "yarn workspaces foreach -A run test ",
    "type-check": "yarn workspaces foreach -A run type-check",
    "pre-pr": "yarn type-check && yarn test:ci && yarn build"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=4.0.0"
  }
}
